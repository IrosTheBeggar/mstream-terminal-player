#!/usr/bin/expect -f
# The GUI player's Discover room against the fake server's taste route
# (test/e2e/fake_mstream.py, FAKE_TASTE=1; docs/ux-contracts/
# discovery-page.md). The ping advertises `discoveryTaste`, so the nav
# grows its Discover row (clause 1); `G` opens the room, which asks the
# route and paints its answer: the refresh's "new seeds" (clause 17 —
# "asking…" while the ask is out), then the tagline at the tabs row's
# right, "based on songs you finished" — words, no count, the play-now
# page (the contract's 2026-10-11 log; the tabs row's since 2026-10-16,
# where the queue-open room's 67 cells at 120 columns hold it whole) —
# over the Library tab with its album strip — the answer's one album, a tile whose
# title paints above the table and whose cover the room fetches from
# /album-art/ (clauses 45-49; the strip stands at every height the GUI
# draws since 2026-10-16) — then the verbs line over the table, whose "save as playlist…"
# paints between the strip and the rows (clause 64, the 2026-10-16 log:
# the webapp's whole-list verbs ahead of its songs; no bottom row) — and
# its rows (clauses 3, 30, 40). → then switches to the Connected servers
# tab (the ping advertises `federationDiscovery`, so the room asked the
# peers half once Main landed): its strip's one album, "Lanterns", a tile
# whose cover the room fetches from the peer through the parent's
# federation art proxy by the row's `albumArt` (mStream 2026-10-16; run.sh
# asserts the fetch's path). The header's controls paint with the
# room's first frame, before the answer, so they are gated first, each on
# one word (the terminal is sent only what changed, word by word with the
# cursor moved over the spaces): the window dropdown, "Last 30 days"
# (clause 15 — the default, nothing remembered yet), then "more options"
# (clause 17, the 2026-10-16 header log: the seeds modal's way in — the
# room shows no state line and no seeds line any more; its two words are
# one DIM run, so the space between them is sent too). The page is
# stateless since 2026-10-14: no filter checkbox, no prefs (the fake 404s the prefs route and 400s
# `remember`/`filter`, and run.sh asserts the last body). `0` opens Now Playing,
# whose per-song tab reads Similar now (plan §2.12). Esc comes back, q
# quits. Gates on first-paint words only (the tagline is a phrase
# the room paints only once the answer landed, the title a row's), and
# each gate's braces span lines: expect reads a braced list on one line as
# a single pattern, which never matches and lets the leg run on past a
# screen that never painted.
set timeout 20
set env(TERM) xterm-256color
set env(MSTREAM_SETUP_LANG) en
set env(MSTREAM_NO_GRAPHICS) 1
set env(MSTREAM_NO_OPEN) 1
set env(HOME) $::env(WIZHOME)
set env(MSTREAM_PLAYER_CONFIG_DIR) $::env(WIZHOME)/player
proc drain {secs} { expect -timeout $secs timeout {} }
proc fail {word code} { puts $word; exec kill -9 [exp_pid]; expect eof; exit $code }
spawn {*}$argv
exec stty rows 34 columns 120 < $spawn_out(slave,name)
expect {
    "Discover" {}
    eof { puts "DIED-EARLY"; exit 6 }
    timeout { fail "NO-DISCOVER-ROW" 2 }
}
drain 1
send "G"
expect {
    "days" {}
    eof { puts "DIED-ON-WINDOW"; exit 11 }
    timeout { fail "NO-WINDOW-DROPDOWN" 12 }
}
expect {
    "more options" {}
    eof { puts "DIED-ON-OPTIONS"; exit 17 }
    timeout { fail "NO-MORE-OPTIONS" 18 }
}
# The answer's words IN ORDER — the room header, the strip's "Nightfall",
# the verbs line's "playlist" (clause 64: between the strip and the rows,
# so the footer tip's "save as playlist" painted before the strip is
# consumed by the "Nightfall" gate and cannot satisfy it), the rows'
# "Aurora" — with the refresh's "new seeds" allowed ANYWHERE among them:
# the peers half lands after Main, so it may paint in a later frame than
# Main's rows (or in the same frame, top row first). Each step's regex
# alternation consumes only through the EARLIEST of its words in the
# buffer, so a "new seeds" that painted first is not skipped past.
set seeds 0
foreach {word died died_code missing missing_code} {
    "based on songs you finished" DIED-ON-G 7 NO-ROOM-HEADER 3
    "Nightfall" DIED-ON-STRIP 13 NO-ALBUM-STRIP 14
    "playlist" DIED-ON-VERBS 15 NO-VERBS-LINE 16
    "Aurora" DIED-ON-ROWS 8 NO-ROOM-ROWS 4
} {
    set found 0
    while {!$found} {
        set alts [expr {$seeds ? $word : "new seeds|$word"}]
        expect {
            -re "($alts)" {
                if {$expect_out(1,string) eq "new seeds"} { set seeds 1 } else { set found 1 }
            }
            eof { puts $died; exit $died_code }
            timeout { fail $missing $missing_code }
        }
    }
}
if {!$seeds} {
    expect {
        "new seeds" {}
        eof { puts "DIED-ON-REFRESH"; exit 19 }
        timeout { fail "NO-NEW-SEEDS" 20 }
    }
}
drain 1
send "\x1b\[C"
expect {
    "Lanterns" {}
    eof { puts "DIED-ON-SERVERS"; exit 21 }
    timeout { fail "NO-PEER-ALBUM" 22 }
}
drain 1
send "0"
expect {
    "Similar" {}
    eof { puts "DIED-ON-0"; exit 9 }
    timeout { fail "NO-SIMILAR-TAB" 5 }
}
drain 1
send "\x1b"
drain 1
send "q"
expect {
    eof {}
    timeout { fail "NO-QUIT" 10 }
}
catch wait result
exit [lindex $result 3]
