#!/usr/bin/expect -f
# Phase 1: folders + extras committed, then QUIT before creating the
# admin (Ctrl+C). The open-admin window must survive for phase 2.
set timeout 20
set env(TERM) xterm-256color
set env(MSTREAM_SETUP_LANG) en
# No pixel probe under expect: nothing answers, and the 2s stall is pure wait.
set env(MSTREAM_NO_GRAPHICS) 1
set env(HOME) $::env(WIZHOME)
proc drain {secs} { expect -timeout $secs timeout {} }
spawn {*}$argv
exec stty rows 40 columns 100 < $spawn_out(slave,name)
expect { "Add a music folder" {} timeout { exit 2 } }
send "t"
drain 1
send "$::env(WIZMUSIC)\r"
drain 1
send "c"
expect { "All optional" {} timeout { exit 4 } }
drain 1
send "c"
expect { "Admin User" {} timeout { exit 5 } }
drain 1
send "\x03"
expect eof
exit 0
