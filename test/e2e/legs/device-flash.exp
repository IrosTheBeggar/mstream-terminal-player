#!/usr/bin/expect -f
# The MP3 player's page on the fake board (MSTREAM_DEVICE_FAKE in the
# environment, the image file in argv): the board is heard without a reset
# — an older version of our firmware — and its card offers Update; Enter
# opens the gate, y writes, the card comes back up to date ("just
# written"), d opens Details, and Esc lets the ports go and leaves.
set timeout 20
set env(TERM) xterm-256color
set env(MSTREAM_SETUP_LANG) en
set env(MSTREAM_NO_GRAPHICS) 1
set env(HOME) $::env(WIZHOME)
set env(XDG_CONFIG_HOME) $::env(WIZHOME)/.config
proc drain {secs} { expect -timeout $secs timeout {} }
spawn {*}$argv
exec stty rows 30 columns 100 < $spawn_out(slave,name)
# The primary's verb: the fake board runs v0.4.0, the image is v0.5.0.
expect {
  "Update" {}
  timeout { puts "NO-CARD"; exec kill -9 [exp_pid]; expect eof; exit 2 }
}
drain 1
send "\r"
# The gate: its safe choice names what stays.
expect {
  "Keep" {}
  timeout { puts "NO-GATE"; exec kill -9 [exp_pid]; expect eof; exit 3 }
}
drain 1
send "y"
# The fake's write takes about a second; the board is heard again and the
# chip says it was just written. Only the cells that change reach the
# terminal (ratatui's diff), so the word that is new is what is matched.
expect {
  "written" {}
  timeout { puts "NO-DONE"; exec kill -9 [exp_pid]; expect eof; exit 4 }
}
drain 1
send "d"
expect {
  "Port" {}
  timeout { puts "NO-DETAILS"; exec kill -9 [exp_pid]; expect eof; exit 5 }
}
drain 1
send "\033"
expect eof
exit 0
