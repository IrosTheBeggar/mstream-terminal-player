#!/usr/bin/expect -f
# The Done page's button list from the keyboard: Up from nothing selects
# the LAST button (the admin panel); under the MSTREAM_NO_OPEN seam its
# note carries the /admin URL instead of popping a browser.
set timeout 20
set env(TERM) xterm-256color
set env(MSTREAM_SETUP_LANG) en
set env(MSTREAM_NO_GRAPHICS) 1
set env(HOME) $::env(WIZHOME)
proc drain {secs} { expect -timeout $secs timeout {} }
spawn {*}$argv
exec stty rows 40 columns 100 < $spawn_out(slave,name)
expect { "running!" {} eof { puts "DIED-EARLY"; exit 6 } timeout { puts "NO-PAGE"; exec kill -9 [exp_pid]; expect eof; exit 2 } }
drain 2
send "\x1b\[A"
drain 1
send "\r"
expect { "/admin" {} timeout { puts "NO-ADMIN-NOTE"; exec kill -9 [exp_pid]; expect eof; exit 3 } }
drain 1
send "\x1b"
expect { eof {} timeout { exec kill -9 [exp_pid]; expect eof; exit 4 } }
catch wait result
exit [lindex $result 3]
